// schema.prisma
datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum TipoTransaccion {
  ALQUILER
  VENTA
  PROYECTO
}

enum EstadoEquipo {
  DISPONIBLE
  RESERVADO
  ALQUILADO
  EN_MANTENIMIENTO
  EN_CALIBRACION
  FUERA_DE_SERVICIO
  EN_REPARACION
  DADO_DE_BAJA
}

enum Rol {
  ADMINISTRADOR
  GERENCIA
  COMERCIAL
  LOGISTICA
  OPERACIONES
  CONTABILIDAD
  ALMACEN
  CONSULTA
}

enum TipoDocumento {
  FOTOGRAFIA
  MANUAL
  FICHA_TECNICA
  CERTIFICADO
  FACTURA
  GARANTIA
  OTRO
}

enum TipoEvento {
  COMPRA
  PRIMER_ALQUILER
  ALQUILER
  MANTENIMIENTO
  CALIBRACION
  REPARACION
  INSPECCION
  OBSERVACION
  INCIDENTE
  CAMBIO_ESTADO
}

enum EstadoContrato {
  BORRADOR
  CONFIRMADO
  EN_CURSO
  FINALIZADO
  CANCELADO
}

enum TipoInspeccion {
  ENTREGA
  RETORNO
}

enum ResultadoChecklist {
  OK
  NO_OK
  NA
}

enum TipoMantenimiento {
  PREVENTIVO
  CORRECTIVO
  CALIBRACION
  INSPECCION
}

enum PrioridadOrden {
  BAJA
  MEDIA
  ALTA
  URGENTE
}

enum EstadoOrdenTrabajo {
  PENDIENTE
  EN_PROGRESO
  COMPLETADO
  CANCELADO
}

model Familia {
  id          String       @id @default(uuid())
  nombre      String       @unique
  descripcion String?
  subfamilias Subfamilia[]
  equipos     Equipo[]
  createdAt   DateTime     @default(now())
}

model Subfamilia {
  id        String   @id @default(uuid())
  nombre    String
  familiaId String
  familia   Familia  @relation(fields: [familiaId], references: [id], onDelete: Cascade)
  equipos   Equipo[]
  createdAt DateTime @default(now())

  @@unique([familiaId, nombre])
}

model Equipo {
  id              String           @id @default(uuid())
  codigoInterno   String?          @unique
  nombre          String
  familiaId       String?
  familia         Familia?         @relation(fields: [familiaId], references: [id])
  subfamiliaId    String?
  subfamilia      Subfamilia?      @relation(fields: [subfamiliaId], references: [id])
  marca           String?
  modelo          String?
  serie           String?
  anio            Int?
  proveedor       String?
  costo           Decimal?         @db.Decimal(12, 2)
  valorComercial  Decimal?         @db.Decimal(12, 2)
  valorReposicion Decimal?         @db.Decimal(12, 2)
  estado          EstadoEquipo     @default(DISPONIBLE)
  ubicacion       String
  categoria       String
  descripcion     String           @db.Text
  precio          Decimal?         @db.Decimal(10, 2)
  unidad          String?
  tipo            TipoTransaccion
  imagenUrl       String
  imagenThumbUrl  String?
  disponible      Boolean          @default(true)
  destacado       Boolean          @default(false)
  observaciones   String?          @db.Text
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  // Variantes de Producto (Modelo Padre - Hijo)
  padreId         String?
  padre           Equipo?          @relation("EquipoVariantes", fields: [padreId], references: [id], onDelete: Cascade)
  variantes       Equipo[]         @relation("EquipoVariantes")
  varianteNombre  String?

  documentos    DocumentoEquipo[]
  historial     HistorialEquipo[]
  CotizacionItem CotizacionItem[]
  contratoItems ContratoItem[]
  ordenesTrabajo OrdenTrabajo[]
  planesMantenimiento PlanMantenimiento[]

  // Índices para optimizar velocidad de consultas (Performance)
  @@index([padreId])
  @@index([estado])
  @@index([categoria])
  @@index([tipo])
  @@index([destacado])
}

model DocumentoEquipo {
  id        String        @id @default(uuid())
  equipoId  String
  equipo    Equipo        @relation(fields: [equipoId], references: [id], onDelete: Cascade)
  tipo      TipoDocumento
  nombre    String
  url       String
  mimeType  String?
  tamano    Int?
  createdAt DateTime      @default(now())
}

model HistorialEquipo {
  id            String    @id @default(uuid())
  equipoId      String
  equipo        Equipo    @relation(fields: [equipoId], references: [id], onDelete: Cascade)
  tipo          TipoEvento
  descripcion   String    @db.Text
  fecha         DateTime  @default(now())
  usuarioNombre String?
  createdAt     DateTime  @default(now())
}

model Usuario {
  id               String        @id @default(uuid())
  nombre           String
  email            String        @unique
  passwordHash     String
  rol              Rol           @default(CONSULTA)
  activo           Boolean       @default(true)
  resetToken       String?       @unique // Token de restablecimiento de contraseña
  resetTokenExpira DateTime?     // Expiración del token (1 hora)
  createdAt        DateTime      @default(now())

  auditorias       AuditoriaLog[]
  contratosCreados ContratoAlquiler[]
  ordenesTrabajo   OrdenTrabajo[]
}

model AuditoriaLog {
  id        String   @id @default(uuid())
  usuarioId String?
  email     String?
  rol       String?
  accion    String
  entidad   String
  entidadId String?
  detalle   String?  @db.Text
  ip        String?
  createdAt DateTime @default(now())
  usuario   Usuario? @relation(fields: [usuarioId], references: [id])
}

model Cotizacion {
  id              String           @id @default(uuid())
  clienteNombre   String
  clienteEmpresa  String?
  clienteEmail    String
  clienteTelefono String
  mensaje         String?          @db.Text
  totalEstimado   Decimal?         @db.Decimal(10, 2)
  estado          String           @default("PENDIENTE") // PENDIENTE, COTIZADA, APROBADA, CONTRATO, RECHAZADA
  proformaConfig  Json?            // Guarda la configuración del PDF (precios extra, flete, igv, etc)
  contratoId      String?          @unique // Contrato de alquiler generado desde la cotización aprobada
  contrato        ContratoAlquiler? @relation(fields: [contratoId], references: [id], onDelete: SetNull)
  createdAt       DateTime         @default(now())

  items           CotizacionItem[]
}

model CotizacionItem {
  id             String     @id @default(uuid())
  cotizacionId   String
  equipoId       String
  cantidad       Int        @default(1)
  precioUnitario Decimal?   @db.Decimal(10, 2) // Precio asignado por el admin en la proforma
  
  cotizacion     Cotizacion @relation(fields: [cotizacionId], references: [id], onDelete: Cascade)
  equipo         Equipo     @relation(fields: [equipoId], references: [id])
}

model ContratoAlquiler {
  id                String            @id @default(uuid())
  numero            String            @unique
  clienteNombre     String
  clienteEmpresa    String?
  clienteDocumento  String?
  clienteEmail      String
  clienteTelefono   String
  proyecto          String
  sede              String
  fechaInicio       DateTime
  fechaFin          DateTime
  estado            EstadoContrato    @default(BORRADOR)
  subtotal          Decimal?          @db.Decimal(12, 2)
  igv               Decimal?          @db.Decimal(12, 2)
  total             Decimal?          @db.Decimal(12, 2)
  condiciones       String?           @db.Text
  observaciones     String?           @db.Text
  responsableNombre String?
  usuarioId         String?
  usuario           Usuario?          @relation(fields: [usuarioId], references: [id])
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  items        ContratoItem[]
  inspecciones Inspeccion[]
  cotizacion   Cotizacion?
  comprobantes Comprobante[]
}

enum TipoComprobante {
  FACTURA
  BOLETA
  NOTA_CREDITO
  NOTA_DEBITO
}

enum EstadoComprobante {
  BORRADOR
  EMITIDO
  ACEPTADO
  ANULADO
  RECHAZADO
}

model Comprobante {
  id               String            @id @default(uuid())
  tipo             TipoComprobante   @default(FACTURA)
  serie            String            @default("F001")
  numero           Int               @default(1)
  clienteTipoDoc   String            @default("6") // 6: RUC, 1: DNI
  clienteNumDoc    String
  clienteRazon     String
  clienteDireccion String?
  clienteEmail     String?
  montoSubtotal    Decimal           @db.Decimal(12, 2)
  montoIgv         Decimal           @db.Decimal(12, 2)
  montoTotal       Decimal           @db.Decimal(12, 2)
  moneda           String            @default("PEN") // PEN o USD
  estado           EstadoComprobante @default(ACEPTADO)
  pdfUrl           String?           @db.Text
  xmlUrl           String?           @db.Text
  observacion      String?           @db.Text
  contratoId       String?
  contrato         ContratoAlquiler? @relation(fields: [contratoId], references: [id], onDelete: SetNull)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
}

model ContratoItem {
  id             String           @id @default(uuid())
  contratoId     String
  contrato       ContratoAlquiler @relation(fields: [contratoId], references: [id], onDelete: Cascade)
  equipoId       String
  equipo         Equipo           @relation(fields: [equipoId], references: [id])
  cantidad       Int              @default(1)
  precioUnitario Decimal?         @db.Decimal(10, 2)
  subtotal       Decimal?         @db.Decimal(12, 2)

  @@unique([contratoId, equipoId])
}

model Inspeccion {
  id                String           @id @default(uuid())
  contratoId        String
  contrato          ContratoAlquiler @relation(fields: [contratoId], references: [id], onDelete: Cascade)
  tipo              TipoInspeccion
  fecha             DateTime         @default(now())
  responsableNombre String?
  observaciones     String?          @db.Text
  createdAt         DateTime         @default(now())

  items InspeccionItem[]
}

model InspeccionItem {
  id           String             @id @default(uuid())
  inspeccionId String
  inspeccion   Inspeccion         @relation(fields: [inspeccionId], references: [id], onDelete: Cascade)
  descripcion  String
  resultado    ResultadoChecklist @default(NA)
  observacion  String?            @db.Text
}

model OrdenTrabajo {
  id                String             @id @default(uuid())
  numero            String             @unique
  equipoId          String
  equipo            Equipo             @relation(fields: [equipoId], references: [id])
  tipo              TipoMantenimiento
  prioridad         PrioridadOrden     @default(MEDIA)
  estado            EstadoOrdenTrabajo @default(PENDIENTE)
  descripcion       String             @db.Text
  fechaProgramada   DateTime
  fechaInicio       DateTime?
  fechaFin          DateTime?
  tecnicoResponsable String?
  costoRepuestos    Decimal?           @db.Decimal(12, 2)
  costoManoObra     Decimal?           @db.Decimal(12, 2)
  observaciones     String?            @db.Text
  usuarioId         String?
  usuario           Usuario?           @relation(fields: [usuarioId], references: [id])
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  tareas TareaMantenimiento[]
}

model TareaMantenimiento {
  id             String       @id @default(uuid())
  ordenTrabajoId String
  ordenTrabajo   OrdenTrabajo @relation(fields: [ordenTrabajoId], references: [id], onDelete: Cascade)
  descripcion    String
  realizado      Boolean      @default(false)
  observacion    String?      @db.Text
}

model PlanMantenimiento {
  id           String   @id @default(uuid())
  equipoId     String
  equipo       Equipo   @relation(fields: [equipoId], references: [id])
  frecuencia   String // MENSUAL, TRIMESTRAL, SEMESTRAL, ANUAL
  descripcion  String   @db.Text
  proximaFecha DateTime
  ultimaFecha  DateTime?
  activo       Boolean  @default(true)
  createdAt    DateTime @default(now())
}
